# Copia este archivo a .env.prod y rellena valores reales. NUNCA subas .env.prod a git, y
# nunca dejes ninguno de estos valores de ejemplo tal cual: el backend se niega a arrancar
# fuera de dev/demo si JWT_SECRET falta, es corto o sigue siendo el de ejemplo del repo.
#
# Uso: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Dominio real para HTTPS automático (Let's Encrypt), p. ej. "gymflow.ejemplo.com".
# Para una primera prueba sin dominio todavía, usa ":80" (o una IP) y Caddy sirve en HTTP sin
# intentar pedir un certificado.
DOMAIN=gymflow.ejemplo.com

# URL pública completa, CON esquema, por la que se llega a la app desde el navegador. Tiene que
# coincidir con DOMAIN (mismo host) y con su esquema real: "https://..." con un dominio de
# verdad, "http://..." si DOMAIN es una IP o ":80" sin HTTPS todavía. El frontend la hornea en
# el bundle del navegador en tiempo de build, y el backend solo acepta peticiones CORS desde
# aquí.
PUBLIC_URL=https://gymflow.ejemplo.com

POSTGRES_DB=gymflow
POSTGRES_USER=gymflow
# Sin valor de ejemplo a propósito: ponlo tú. Por ejemplo: openssl rand -base64 24
POSTGRES_PASSWORD=

# Mínimo 32 caracteres, aleatorio, distinto en cada despliegue. Genera uno con:
#   openssl rand -base64 48
JWT_SECRET=

# ---- Servicio de IA: cualquier proveedor compatible con OpenAI (ver README) ----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Administrador real del gimnasio (lo crea ProductionAdminSeeder si no existe ya). Mínimo 12
# caracteres en la contraseña; cámbiala después del primer login si quieres.
ADMIN_EMAIL=
ADMIN_PASSWORD=
