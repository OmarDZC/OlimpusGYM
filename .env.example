# Copia este archivo a .env y ajusta los valores. NUNCA subas .env a git.

# dev/demo activa el seed de datos de ejemplo (tenant olympusgym, owner, staff,
# socios y tarifas). Cambia a otro valor (p. ej. "prod") para desactivarlo.
SPRING_PROFILES_ACTIVE=dev

POSTGRES_DB=gymflow
POSTGRES_USER=gymflow
POSTGRES_PASSWORD=gymflow

# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-32b

# ---- Servicio de IA: proveedor intercambiable (API compatible con OpenAI) ----
# Opción A (por defecto): Ollama en tu máquina, gratis y sin tokens.
#   Con docker compose: LLM_BASE_URL=http://ollama:11434/v1  (perfil "local-llm")
#   Con Ollama instalado fuera de Docker: http://host.docker.internal:11434/v1
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b
#
# Opción B: Groq (capa gratuita con límites)
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=tu_clave
#   LLM_MODEL=<modelo disponible en tu cuenta>
#
# Opción C: Google Gemini (AI Studio, capa gratuita con límites)
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_API_KEY=tu_clave
#   LLM_MODEL=<modelo disponible en tu cuenta>
#
# Opción D: OpenRouter (modelos ":free")
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=tu_clave
#   LLM_MODEL=<modelo con sufijo :free>
# Los modelos gratuitos y sus límites cambian: consulta la web de cada proveedor.

# Stripe (modo test) - se usará en la Fase 1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
